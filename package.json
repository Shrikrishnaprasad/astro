{
  "name": "astro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:icons": "python scripts/generate-pwa-icons.py",
    "generate:india": "node scripts/generate-india-places.mjs",
    "test": "vitest run",
    "electron": "cross-env ELECTRON_DEV=true electron .",
    "app": "concurrently -k -s last \"vite --port 7315\" \"wait-on http://localhost:7315 && cross-env ELECTRON_DEV=true VITE_PORT=7315 electron .\""
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.2",
    "wait-on": "^9.5.1"
  }
}
